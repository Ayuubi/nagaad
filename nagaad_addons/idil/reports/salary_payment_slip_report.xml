<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="payment_slip_template">
        <t t-call="web.html_container">
            <t t-foreach="doc_ids" t-as="doc">
                <div class="page">
                    <h2>Payment Slip</h2>
                    <p>
                        <strong>Employee:</strong>
                        <t t-esc="doc.employee_id.name"/>
                    </p>
                    <p>
                        <strong>Date:</strong>
                        <t t-esc="doc.salary_date"/>
                    </p>
                    <p>
                        <strong>Basic Salary:</strong>
                        <t t-esc="doc.basic_salary"/>
                    </p>
                    <p>
                        <strong>Bonus:</strong>
                        <t t-esc="doc.bonus"/>
                    </p>
                    <p>
                        <strong>Deductions:</strong>
                        <t t-esc="doc.deductions"/>
                    </p>
                    <p>
                        <strong>Total Salary:</strong>
                        <t t-esc="doc.total_salary"/>
                    </p>
                </div>
            </t>
        </t>
    </template>

    <record id="report_payment_slip" model="ir.actions.report">
        <field name="name">Payment Slip</field>
        <field name="model">idil.employee.salary</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">idil.payment_slip_template</field>
    </record>
</odoo>
